+      relayEnabled: true,
+      relayEndpoint: `127.0.0.1:${relayPort}`,
+    });
+
+    let client: DaemonClient | null = null;
+    const sockets: WebSocket[] = [];
+    let unsubscribeRaw: (() => void) | null = null;
+
+    try {
