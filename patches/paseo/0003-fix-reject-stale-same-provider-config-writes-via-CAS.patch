diff --git a/packages/app/src/hooks/use-daemon-config.test.tsx b/packages/app/src/hooks/use-daemon-config.test.tsx
new file mode 100644
index 0000000..69746d0
--- /dev/null
+++ b/packages/app/src/hooks/use-daemon-config.test.tsx
@@ -0,0 +1,120 @@
+/**
+ * @vitest-environment jsdom
+ */
+import React, { act } from "react";
+import { QueryClient, QueryClientProvider } from "@tanstack/react-query";
+import { renderHook } from "@testing-library/react";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import type { MutableDaemonConfig } from "@getpaseo/protocol/messages";
+import { daemonConfigQueryKey, type DaemonConfigSnapshot } from "@/data/daemon-config";
+import { DaemonConfigConflictError, useDaemonConfig } from "./use-daemon-config";
+
+const { patchDaemonConfigMock } = vi.hoisted(() => ({
+  patchDaemonConfigMock: vi.fn(),
+}));
+
+vi.mock("react-i18next", () => ({
+  useTranslation: () => ({ t: (key: string) => key }),
+}));
+
+vi.mock("@/runtime/host-runtime", () => ({
+  useHostRuntimeClient: () => ({
+    patchDaemonConfig: patchDaemonConfigMock,
+    getDaemonConfig: vi.fn(),
+  }),
+  useHostRuntimeIsConnected: () => true,
+}));
+
+vi.mock("@/data/query", () => ({
+  useReplicaQuery: () => ({ data: undefined, isLoading: false }),
+}));
+
+const emptyConfig = {
+  relay: { enabled: false },
+  mcp: { injectIntoAgents: false },
+  browserTools: { enabled: false },
+  providers: {},
+  metadataGeneration: { providers: [] },
+  autoArchiveAfterMerge: false,
+  enableTerminalAgentHooks: false,
+  appendSystemPrompt: "",
+} as unknown as MutableDaemonConfig;
+
+function renderPatchHook(snapshot: DaemonConfigSnapshot | undefined) {
+  const queryClient = new QueryClient({ defaultOptions: { queries: { retry: false } } });
+  if (snapshot) {
+    queryClient.setQueryData(daemonConfigQueryKey("server-1"), snapshot);
+  }
+  const wrapper = ({ children }: { children: React.ReactNode }) => (
+    <QueryClientProvider client={queryClient}>{children}</QueryClientProvider>
+  );
+  return renderHook(() => useDaemonConfig("server-1"), { wrapper });
+}
+
+describe("useDaemonConfig patchConfig", () => {
+  beforeEach(() => {
+    patchDaemonConfigMock.mockReset();
+  });
+
+  it("sends the last-read revision with a provider save", async () => {
+    patchDaemonConfigMock.mockResolvedValue({
+      config: emptyConfig,
+      revision: "rev-2",
+    });
+    const { result } = renderPatchHook({ config: emptyConfig, revision: "rev-1" });
+
+    await act(async () => {
+      await result.current.patchConfig({
+        providers: { alpha: { extends: "codex", label: "Alpha", enabled: true } },
+      });
+    });
+
+    expect(patchDaemonConfigMock).toHaveBeenCalledWith(
+      { providers: { alpha: { extends: "codex", label: "Alpha", enabled: true } } },
+      { expectedRevision: "rev-1" },
+    );
+  });
+
+  it("omits expectedRevision when the last read had none", async () => {
+    patchDaemonConfigMock.mockResolvedValue({ config: emptyConfig });
+    const { result } = renderPatchHook({ config: emptyConfig });
+
+    await act(async () => {
+      await result.current.patchConfig({ appendSystemPrompt: "ok" });
+    });
+
+    expect(patchDaemonConfigMock).toHaveBeenCalledWith({ appendSystemPrompt: "ok" }, undefined);
+  });
+
+  it("throws DaemonConfigConflictError without dropping the authoritative snapshot", async () => {
+    const authoritative = {
+      ...emptyConfig,
+      providers: { alpha: { extends: "codex", label: "Alpha renamed by A", enabled: true } },
+    } as unknown as MutableDaemonConfig;
+    patchDaemonConfigMock.mockResolvedValue({
+      config: authoritative,
+      revision: "rev-2",
+      conflict: true,
+    });
+    const { result } = renderPatchHook({ config: emptyConfig, revision: "rev-1" });
+
+    await expect(
+      act(async () => {
+        await result.current.patchConfig({
+          providers: {
+            alpha: { extends: "codex", label: "Alpha", enabled: true, description: "changed by B" },
+          },
+        });
+      }),
+    ).rejects.toSatisfy((error: unknown) => {
+      expect(error).toBeInstanceOf(DaemonConfigConflictError);
+      expect(error).toMatchObject({
+        name: "DaemonConfigConflictError",
+        config: authoritative,
+        revision: "rev-2",
+      });
+      expect((error as Error).message).toMatch(/Reload the latest configuration and retry/);
+      return true;
+    });
+  });
+});
