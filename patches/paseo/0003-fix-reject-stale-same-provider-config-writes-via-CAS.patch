+  test("concurrent adds of different provider keys keep both when revision is omitted", () => {
+    const paseoHome = mkdtempSync(path.join(tmpdir(), "paseo-daemon-config-store-"));
+    tempDirs.push(paseoHome);
+    const store = new DaemonConfigStore(paseoHome, {
+      relay: { enabled: false },
+      mcp: { injectIntoAgents: false },
+      browserTools: { enabled: false },
+      providers: {},
+      metadataGeneration: { providers: [] },
+      autoArchiveAfterMerge: false,
+      enableTerminalAgentHooks: false,
+      appendSystemPrompt: "",
+    });
+
+    store.patch({
+      providers: { alpha: { extends: "codex", label: "Alpha", enabled: true } },
+    });
+    store.patch({
+      providers: { beta: { extends: "codex", label: "Beta", enabled: true } },
+    });
+
+    expect(store.get().providers?.alpha).toMatchObject({ label: "Alpha", enabled: true });
+    expect(store.get().providers?.beta).toMatchObject({ label: "Beta", enabled: true });
+  });
+
+  test("a stale expectedRevision does not replace another client's same-provider field", () => {
+    const paseoHome = mkdtempSync(path.join(tmpdir(), "paseo-daemon-config-store-"));
+    tempDirs.push(paseoHome);
+    const store = new DaemonConfigStore(paseoHome, {
+      relay: { enabled: false },
+      mcp: { injectIntoAgents: false },
+      browserTools: { enabled: false },
+      providers: {},
+      metadataGeneration: { providers: [] },
+      autoArchiveAfterMerge: false,
+      enableTerminalAgentHooks: false,
+      appendSystemPrompt: "",
+    });
+
+    store.patch({
+      providers: {
+        alpha: {
+          extends: "codex",
+          label: "Alpha",
+          enabled: true,
+          description: "original",
+        },
+      },
+    });
+    const sharedRevision = store.getRevision();
+
+    store.patch(
+      {
+        providers: {
+          alpha: {
+            extends: "codex",
+            label: "Alpha renamed by A",
+            enabled: true,
+            description: "original",
+          },
+        },
+      },
+      sharedRevision,
+    );
+    const afterFirstWrite = store.getRevision();
+    expect(store.get().providers?.alpha).toMatchObject({
+      label: "Alpha renamed by A",
+      description: "original",
+    });
+
+    expect(() =>
+      store.patch(
+        {
+          providers: {
+            alpha: {
+              extends: "codex",
+              label: "Alpha",
+              enabled: true,
+              description: "changed by B",
+            },
+          },
+        },
+        sharedRevision,
+      ),
+    ).toThrow(DaemonConfigRevisionConflictError);
+
+    expect(store.get().providers?.alpha).toMatchObject({
+      label: "Alpha renamed by A",
+      description: "original",
+    });
+    expect(store.getRevision()).toBe(afterFirstWrite);
+  });
+
+  test("an omitted expectedRevision bypasses the conflict check", () => {
+    const paseoHome = mkdtempSync(path.join(tmpdir(), "paseo-daemon-config-store-"));
+    tempDirs.push(paseoHome);
+    const store = new DaemonConfigStore(paseoHome, {
+      relay: { enabled: false },
+      mcp: { injectIntoAgents: false },
+      browserTools: { enabled: false },
+      providers: {},
+      metadataGeneration: { providers: [] },
+      autoArchiveAfterMerge: false,
+      enableTerminalAgentHooks: false,
+      appendSystemPrompt: "",
+    });
+
+    const staleRevision = store.getRevision();
+    store.patch({ appendSystemPrompt: "first" }, staleRevision);
+
+    store.patch({ appendSystemPrompt: "second" });
+
+    expect(store.get().appendSystemPrompt).toBe("second");
+  });
+
