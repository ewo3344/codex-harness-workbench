+
+function countAssistantTimelineMessages(
+  messages: SessionOutboundMessage[],
+  agentId: string,
+  text: string,
+): number {
+  let count = 0;
+  for (const message of messages) {
+    if (isAssistantTimelineMessage(message, agentId, text)) {
+      count += 1;
+    }
+  }
+  return count;
