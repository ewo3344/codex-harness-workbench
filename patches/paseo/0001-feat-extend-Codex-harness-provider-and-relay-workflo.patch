index e7fa5c814cd6f9abd35e494b7bb99948940be850..712b601a8aead67657ec211ea6422ebda4082926 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -405,6 +405,62 @@ jobs:
       PLAYWRIGHT_ARTIFACT: "4"
     steps: *playwright_test_steps
 
+  relay-browser-e2e:
+    name: relay-browser-e2e
+    needs: changes
+    if: ${{ !cancelled() && (needs.changes.outputs.full != 'false' || needs.changes.outputs.browser != 'false' || needs.changes.outputs.relay != 'false' || needs.changes.outputs.server != 'false') }}
+    runs-on: ubuntu-latest
+    timeout-minutes: 20
+    env:
+      ELECTRON_SKIP_BINARY_DOWNLOAD: "1"
+      PASEO_RELAY_CHECKOUT: ${{ github.workspace }}/.ci/paseo-relay
+    steps:
+      - uses: actions/checkout@v4
+
+      - name: Check out pinned Elixir relay
+        uses: actions/checkout@v4
+        with:
+          repository: getpaseo/paseo-relay
+          ref: 3fc41c96c8c63f3a7109e832899cc57d473c4531
+          path: .ci/paseo-relay
+
+      - uses: actions/setup-node@v4
+        with:
+          node-version: "22"
+          cache: "npm"
+
+      - uses: erlef/setup-beam@v1
+        with:
+          otp-version: "29.0.3"
+          elixir-version: "1.20.2"
+
+      - name: Install JavaScript dependencies
+        run: node scripts/npm-retry.mjs ci
+
+      - name: Compile pinned Elixir relay
+        working-directory: .ci/paseo-relay
+        run: mix deps.get && mix compile
+        env:
+          MIX_ENV: prod
+
+      - name: Install Playwright browser
+        timeout-minutes: 10
+        run: npx playwright install chromium
+
+      - name: Run browser relay deployment contracts
+        run: npm run test:e2e:relay-deployment --workspace=@getpaseo/app
+
+      - name: Upload relay browser diagnostics
+        uses: actions/upload-artifact@v4
+        if: failure()
+        with:
+          name: relay-browser-e2e
+          path: |
+            packages/app/test-results/
+            packages/app/playwright-report/
+          if-no-files-found: ignore
+          retention-days: 7
+
   relay-tests:
     name: relay-tests
     needs: changes
