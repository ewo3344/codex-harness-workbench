@@ -0,0 +1,37 @@
+import { DEFAULT_TERMINAL_PROFILES } from "@getpaseo/protocol/terminal-profiles";
+import { expect, test } from "../support/fixtures";
+import { gotoAppShell } from "../support/helpers/app";
+import {
+  attachButton,
+  expectTerminalLaunchSelected,
+  launchOption,
+  openLaunchMenu,
+  seedTerminalProfiles,
+  terminalPromptInput,
+} from "../support/helpers/new-workspace-launch";
+import { openGlobalNewWorkspaceComposer } from "../support/helpers/new-workspace";
+import { seedWorkspace } from "../support/helpers/seed-client";
+import { waitForSidebarHydration } from "../support/helpers/workspace-ui";
+
+test("New Workspace defaults to the Codex CLI terminal", async ({ page }) => {
+  const workspace = await seedWorkspace({ repoPrefix: "default-codex-terminal-" });
+  const profileSeed = await seedTerminalProfiles([...DEFAULT_TERMINAL_PROFILES]);
+
+  try {
+    await gotoAppShell(page);
+    await waitForSidebarHydration(page);
+    await openGlobalNewWorkspaceComposer(page);
+
+    await expectTerminalLaunchSelected(page, "Codex CLI");
+    await expect(terminalPromptInput(page)).toBeEditable();
+    await expect(attachButton(page)).toHaveCount(0);
+
+    await openLaunchMenu(page);
+    await expect(launchOption(page, "codex")).toHaveAttribute("aria-checked", "true");
+    await expect(launchOption(page, "codex")).toContainText("--no-alt-screen");
+    await expect(launchOption(page, "chat")).toHaveAttribute("aria-checked", "false");
+  } finally {
+    await profileSeed.restore();
+    await workspace.cleanup();
+  }
+});
