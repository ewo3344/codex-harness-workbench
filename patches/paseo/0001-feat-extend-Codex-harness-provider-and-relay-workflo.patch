+
+function parseLatestPtySize(text: string): TerminalSize | null {
+  const matches = [...text.matchAll(/RELAY_WEB_PTY_SIZE:(\d+) (\d+)/g)];
+  const latest = matches.at(-1);
+  return latest?.[1] && latest[2] ? { rows: Number(latest[1]), cols: Number(latest[2]) } : null;
+}
