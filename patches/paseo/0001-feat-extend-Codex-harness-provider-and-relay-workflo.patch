diff --git a/packages/app/e2e/support/helpers/local-wrangler-relay.ts b/packages/app/e2e/support/helpers/local-wrangler-relay.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b5d5d7517427a2fd41d577cabc00b62826c0d875
--- /dev/null
+++ b/packages/app/e2e/support/helpers/local-wrangler-relay.ts
@@ -0,0 +1,171 @@
+import { spawn, type ChildProcess } from "node:child_process";
+import { once } from "node:events";
+import net from "node:net";
+import path from "node:path";
+import { WebSocket } from "ws";
+import { buildRelayWebSocketUrl } from "@getpaseo/protocol/daemon-endpoints";
+
+const repoRoot = path.resolve(__dirname, "../../../../../");
+const wranglerCliPath = path.join(repoRoot, "node_modules/wrangler/bin/wrangler.js");
+
+export interface LocalWranglerRelay {
+  endpoint: string;
+  port: number;
+  start(): Promise<void>;
+  stop(): Promise<void>;
+  close(): Promise<void>;
+}
+
+async function availablePort(): Promise<number> {
+  return await new Promise((resolve, reject) => {
+    const server = net.createServer();
+    server.once("error", reject);
+    server.listen(0, "127.0.0.1", () => {
+      const address = server.address();
+      if (!address || typeof address === "string") {
+        server.close(() => reject(new Error("Could not allocate a relay port")));
+        return;
+      }
+      server.close(() => resolve(address.port));
+    });
+  });
+}
+
+async function stopProcess(child: ChildProcess): Promise<void> {
+  if (!child.pid || child.exitCode !== null || child.signalCode !== null) return;
+  child.kill("SIGTERM");
+  const force = setTimeout(() => {
+    if (child.exitCode === null && child.signalCode === null) child.kill("SIGKILL");
+  }, 5_000);
+  try {
+    await once(child, "exit");
+  } finally {
+    clearTimeout(force);
+  }
+}
+
+async function waitForRelayWebSocket(
+  port: number,
+  child: ChildProcess,
+  recentOutput: () => string,
+): Promise<void> {
+  const deadline = Date.now() + 60_000;
+  while (Date.now() < deadline) {
+    if (child.exitCode !== null || child.signalCode !== null) {
+      throw new Error(
+        `Wrangler relay exited before becoming ready (exit ${child.exitCode}, signal ${child.signalCode}).\n${recentOutput()}`,
+      );
+    }
+    const serverId = `browser-relay-probe-${Date.now().toString(36)}`;
+    const url = buildRelayWebSocketUrl({
+      endpoint: `127.0.0.1:${port}`,
+      useTls: false,
+      serverId,
+      role: "server",
+    });
+    const opened = await new Promise<boolean>((resolve) => {
+      let settled = false;
+      const socket = new WebSocket(url);
+      const settle = (value: boolean) => {
+        if (settled) return;
+        settled = true;
+        clearTimeout(timeout);
+        // Socket open, error, and timeout race; this guard resolves exactly once.
+        // oxlint-disable-next-line promise/no-multiple-resolved
+        resolve(value);
+      };
+      const timeout = setTimeout(() => {
+        socket.terminate();
+        settle(false);
+      }, 5_000);
+      socket.once("open", () => {
+        socket.close(1000, "readiness probe");
+        settle(true);
+      });
+      socket.once("error", () => settle(false));
+    });
+    if (opened) return;
+    await new Promise((resolve) => setTimeout(resolve, 250));
+  }
+  throw new Error(
+    `Wrangler relay WebSocket endpoint did not become ready on port ${port}.\n${recentOutput()}`,
+  );
+}
+
+/** Starts the same local Cloudflare relay worker exercised by daemon relay E2E tests. */
+export async function startLocalWranglerRelay(): Promise<LocalWranglerRelay> {
+  const port = await availablePort();
+  const relayRoot = path.join(repoRoot, "packages/relay");
+  let child: ChildProcess | null = null;
+  let closed = false;
+
+  async function start(): Promise<void> {
+    if (closed) throw new Error("Cannot start a closed Wrangler relay");
+    if (child && child.exitCode === null && child.signalCode === null) return;
+
+    let output = "";
+    const appendOutput = (chunk: Buffer) => {
+      output = `${output}${chunk.toString("utf8")}`.split("\n").slice(-120).join("\n");
+    };
+    const nextChild = spawn(
+      process.execPath,
+      [
+        wranglerCliPath,
+        "dev",
+        "--local",
+        "--ip",
+        "127.0.0.1",
+        "--port",
+        String(port),
+        "--live-reload=false",
+        "--show-interactive-dev-session=false",
+        "--var",
+        "PASEO_RELAY_UPSTREAM:",
+      ],
+      {
+        cwd: relayRoot,
+        env: { ...process.env },
+        stdio: ["ignore", "pipe", "pipe"],
+        detached: false,
+      },
+    );
+    child = nextChild;
+    nextChild.stdout?.on("data", appendOutput);
+    nextChild.stderr?.on("data", appendOutput);
+
+    let rejectSpawnFailure: (error: Error) => void = () => undefined;
+    const spawnFailed = new Promise<never>((_resolve, reject) => {
+      rejectSpawnFailure = reject;
+    });
+    const onSpawnError = (error: Error) => rejectSpawnFailure(error);
+    nextChild.once("error", onSpawnError);
+    try {
+      await Promise.race([waitForRelayWebSocket(port, nextChild, () => output), spawnFailed]);
+    } catch (error) {
+      await stopProcess(nextChild);
+      if (child === nextChild) child = null;
+      throw error;
+    } finally {
+      nextChild.off("error", onSpawnError);
+    }
+  }
+
+  async function stop(): Promise<void> {
+    const current = child;
+    child = null;
+    if (current) await stopProcess(current);
+  }
+
+  await start();
+  return {
+    endpoint: `127.0.0.1:${port}`,
+    port,
+    start,
+    stop,
+    async close() {
+      if (closed) return;
+      closed = true;
+      await stop();
+    },
+  };
+}
