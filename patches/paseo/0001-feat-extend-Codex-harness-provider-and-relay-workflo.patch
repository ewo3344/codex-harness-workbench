@@ -0,0 +1,60 @@
+import assert from "node:assert/strict";
+import { readFile } from "node:fs/promises";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+import YAML from "yaml";
+
+const directory = path.dirname(fileURLToPath(import.meta.url));
+const read = (name) => readFile(path.join(directory, name), "utf8");
+
+const [flow, harness] = await Promise.all([
+  read("provider-forms-android.yaml"),
+  read("test-provider-forms-android.sh"),
+]);
+
+const documents = YAML.parseAllDocuments(flow);
+for (const document of documents) {
+  assert.equal(document.errors.length, 0, `Invalid YAML: ${document.errors.join("; ")}`);
+}
+
+for (const expected of [
+  'id: "settings-host-section-providers"',
+  'id: "host-page-providers-card"',
+  'id: "custom-provider-add"',
+  'id: "custom-provider-base-url"',
+  'id: "custom-provider-anthropic-auth-field"',
+  'id: "custom-provider-command"',
+  'id: "custom-provider-args"',
+  'id: "custom-provider-cancel"',
+]) {
+  assert.ok(flow.includes(expected), `Missing Android provider flow step: ${expected}`);
+}
+
+assert.ok(
+  flow.indexOf('id: "custom-provider-kind-anthropic"') <
+    flow.indexOf('id: "custom-provider-kind-acp"'),
+  "The flow must cover Anthropic before ACP after the default OpenAI form",
+);
+
+for (const expected of [
+  'PASEO_HOME="$OUT_DIR/paseo-home"',
+  "PASEO_RELAY_ENABLED=false",
+  "--no-relay --no-mcp --no-inject-mcp",
+  '"${ADB[@]}" reverse "tcp:${PASEO_MAESTRO_PORT}"',
+  '"${ADB[@]}" reverse --remove "tcp:${PASEO_MAESTRO_PORT}"',
+  "mktemp -d /tmp/paseo-provider-forms-android-",
+  '"${PASEO_CLI[@]}" provider ls --host "$PASEO_MAESTRO_DIRECT_ENDPOINT" --json',
+  "provider-after.json",
+]) {
+  assert.ok(harness.includes(expected), `Missing isolated-harness invariant: ${expected}`);
+}
+assert.ok(
+  !harness.includes("scripts/dev-daemon.sh"),
+  "The Android provider harness must not use the worktree development daemon",
+);
+assert.ok(
+  !/^[^#\n]*\.paseo-dev/m.test(harness),
+  "The Android provider harness must not use the default workbench state",
+);
+
+console.log("provider-forms-android contract: OK");
