@@ -0,0 +1,361 @@
+/**
+ * @vitest-environment jsdom
+ */
+import React, { act } from "react";
+import { createRoot, type Root } from "react-dom/client";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import type { CustomProviderDraft } from "./custom-provider-form";
+
+const inputProps = vi.hoisted(() => new Map<string, { onChangeText?: (value: string) => void }>());
+
+vi.mock("react-native", () => ({
+  View: ({ children, testID }: { children?: React.ReactNode; testID?: string }) =>
+    React.createElement("div", { "data-testid": testID }, children),
+  Text: ({ children, testID }: { children?: React.ReactNode; testID?: string }) =>
+    React.createElement("span", { "data-testid": testID }, children),
+  Pressable: ({
+    children,
+    onPress,
+    disabled,
+    accessibilityLabel,
+    testID,
+  }: {
+    children?: React.ReactNode;
+    onPress?: () => void;
+    disabled?: boolean;
+    accessibilityLabel?: string;
+    testID?: string;
+  }) =>
+    React.createElement(
+      "button",
+      {
+        type: "button",
+        disabled,
+        "aria-label": accessibilityLabel,
+        "data-testid": testID,
+        onClick: onPress,
+      },
+      children,
+    ),
+}));
+
+vi.mock("react-native-unistyles", () => ({
+  StyleSheet: {
+    create: (factory: unknown) =>
+      typeof factory === "function"
+        ? (factory as (theme: unknown) => unknown)({
+            spacing: { 2: 8, 4: 16 },
+            borderRadius: { lg: 8 },
+            colors: {
+              foregroundMuted: "#888",
+              surface2: "#222",
+              palette: { red: { 300: "red" } },
+            },
+            fontSize: { base: 14 },
+          })
+        : factory,
+  },
+  withUnistyles: (Component: React.ComponentType<unknown>) => Component,
+}));
+
+vi.mock("lucide-react-native", () => ({
+  Eye: () => React.createElement("span", { "data-icon": "eye" }),
+  EyeOff: () => React.createElement("span", { "data-icon": "eye-off" }),
+}));
+
+vi.mock("react-i18next", () => ({
+  useTranslation: () => ({ t: (key: string) => key }),
+}));
+
+vi.mock("@/constants/layout", () => ({
+  useIsCompactFormFactor: () => false,
+}));
+
+vi.mock("@/components/adaptive-modal-sheet", () => ({
+  AdaptiveModalSheet: ({
+    visible,
+    children,
+    footer,
+    testID,
+  }: {
+    visible: boolean;
+    children?: React.ReactNode;
+    footer?: React.ReactNode;
+    testID?: string;
+  }) => (visible ? React.createElement("div", { "data-testid": testID }, children, footer) : null),
+}));
+
+vi.mock("@/components/ui/button", () => ({
+  Button: ({
+    children,
+    onPress,
+    disabled,
+    testID,
+  }: {
+    children?: React.ReactNode;
+    onPress?: () => void;
+    disabled?: boolean;
+    testID?: string;
+  }) =>
+    React.createElement(
+      "button",
+      { type: "button", disabled, "data-testid": testID, onClick: onPress },
+      children,
+    ),
+}));
+
+vi.mock("@/components/ui/form-field", () => ({
+  Field: ({
+    children,
+    error,
+    testID,
+  }: {
+    children?: React.ReactNode;
+    error?: string | null;
+    testID?: string;
+  }) =>
+    React.createElement(
+      "div",
+      { "data-testid": testID },
+      children,
+      error ? React.createElement("span", { "data-testid": `${testID}-error` }, error) : null,
+    ),
+  FormTextInput: ({
+    initialValue,
+    onChangeText,
+    editable = true,
+    secureTextEntry,
+    testID,
+  }: {
+    initialValue?: string;
+    onChangeText?: (value: string) => void;
+    editable?: boolean;
+    secureTextEntry?: boolean;
+    testID?: string;
+  }) => {
+    if (testID) inputProps.set(testID, { onChangeText });
+    return React.createElement("input", {
+      defaultValue: initialValue,
+      disabled: !editable,
+      type: secureTextEntry ? "password" : "text",
+      "data-testid": testID,
+    });
+  },
+}));
+
+vi.mock("@/components/ui/select-field", () => ({
+  SelectField: ({
+    value,
+    options,
+    onChange,
+    disabled,
+    testID,
+  }: {
+    value: string;
+    options: Array<{ value: string; label: string; testID?: string }>;
+    onChange: (value: string, display: { label: string }) => void;
+    disabled?: boolean;
+    testID?: string;
+  }) =>
+    React.createElement(
+      "div",
+      { "data-testid": testID, "data-value": value },
+      options.map((option) =>
+        React.createElement(
+          "button",
+          {
+            type: "button",
+            key: option.value,
+            "data-testid": option.testID,
+            disabled,
+            onClick: () => onChange(option.value, { label: option.label }),
+          },
+          option.label,
+        ),
+      ),
+    ),
+}));
+
+import { CustomProviderEditSheet } from "./custom-provider-edit-sheet";
+
+const EMPTY_DRAFT: CustomProviderDraft = {
+  id: "",
+  label: "",
+  description: "",
+  kind: "openai",
+  anthropicAuth: "apiKey",
+  baseUrl: "",
+  apiKey: "",
+  command: "",
+  args: "",
+  modelIds: "",
+};
+
+function query(testID: string): HTMLElement | null {
+  return document.querySelector(`[data-testid="${testID}"]`);
+}
+
+function click(testID: string): void {
+  act(() => {
+    query(testID)?.dispatchEvent(new window.MouseEvent("click", { bubbles: true }));
+  });
+}
+
+function typeInto(testID: string, value: string): void {
+  act(() => {
+    inputProps.get(testID)?.onChangeText?.(value);
+  });
+}
+
+describe("CustomProviderEditSheet", () => {
+  let root: Root;
+  let container: HTMLDivElement;
+
+  beforeEach(() => {
+    vi.stubGlobal("React", React);
+    vi.stubGlobal("IS_REACT_ACT_ENVIRONMENT", true);
+    inputProps.clear();
+    container = document.createElement("div");
+    document.body.appendChild(container);
+    root = createRoot(container);
+  });
+
+  afterEach(() => {
+    act(() => root.unmount());
+    container.remove();
+    vi.unstubAllGlobals();
+  });
+
+  function render(
+    options: {
+      initialDraft?: CustomProviderDraft;
+      existingConfig?: Record<string, unknown>;
+      originalId?: string;
+      onSave?: (providerId: string, config: Record<string, unknown>) => Promise<void>;
+      onClose?: () => void;
+    } = {},
+  ) {
+    const onSave = options.onSave ?? vi.fn(async () => {});
+    const onClose = options.onClose ?? vi.fn();
+    act(() => {
+      root.render(
+        <CustomProviderEditSheet
+          visible
+          initialDraft={options.initialDraft ?? EMPTY_DRAFT}
+          existingConfig={options.existingConfig}
+          existingProviderIds={new Set(["codex", "existing-provider"])}
+          originalId={options.originalId}
+          onSave={onSave}
+          onClose={onClose}
+        />,
+      );
+    });
+    return { onSave, onClose };
+  }
+
+  it("switches between API and ACP-specific controls", () => {
+    render();
+    expect(query("custom-provider-base-url")).not.toBeNull();
+    expect(query("custom-provider-api-key")?.getAttribute("type")).toBe("password");
+    expect(query("custom-provider-command")).toBeNull();
+
+    click("custom-provider-kind-acp");
+    expect(query("custom-provider-base-url")).toBeNull();
+    expect(query("custom-provider-command")).not.toBeNull();
+    expect(query("custom-provider-args")).not.toBeNull();
+  });
+
+  it("keeps the API key hidden by default and toggles visibility", () => {
+    render();
+
+    expect(query("custom-provider-api-key")?.getAttribute("type")).toBe("password");
+    click("custom-provider-api-key-visibility");
+    expect(query("custom-provider-api-key")?.getAttribute("type")).toBe("text");
+    click("custom-provider-api-key-visibility");
+    expect(query("custom-provider-api-key")?.getAttribute("type")).toBe("password");
+  });
+
+  it("selects the Anthropic authentication header for new providers", () => {
+    render();
+    click("custom-provider-kind-anthropic");
+
+    expect(query("custom-provider-anthropic-auth-field")?.getAttribute("data-value")).toBe(
+      "apiKey",
+    );
+    click("custom-provider-anthropic-auth-token");
+    expect(query("custom-provider-anthropic-auth-field")?.getAttribute("data-value")).toBe(
+      "authToken",
+    );
+  });
+
+  it("shows field errors and does not submit an invalid draft", async () => {
+    const { onSave } = render();
+    click("custom-provider-save");
+    await act(async () => Promise.resolve());
+
+    expect(onSave).not.toHaveBeenCalled();
+    expect(query("custom-provider-id-field-error")).not.toBeNull();
+    expect(query("custom-provider-label-field-error")).not.toBeNull();
+    expect(query("custom-provider-base-url-field-error")).not.toBeNull();
+    expect(query("custom-provider-models-field-error")).not.toBeNull();
+  });
+
+  it("submits a normalized OpenAI-compatible provider", async () => {
+    const onSave = vi.fn(async () => {});
+    const onClose = vi.fn();
+    render({ onSave, onClose });
+    typeInto("custom-provider-id", " team-openai ");
+    typeInto("custom-provider-label", " Team OpenAI ");
+    typeInto("custom-provider-base-url", " https://api.example.test/v1 ");
+    typeInto("custom-provider-api-key", " secret ");
+    typeInto("custom-provider-models", "model-a\nmodel-b");
+
+    click("custom-provider-save");
+    await act(async () => {
+      await Promise.resolve();
+      await Promise.resolve();
+    });
+
+    expect(onSave).toHaveBeenCalledWith("team-openai", {
+      extends: "codex",
+      enabled: true,
+      label: "Team OpenAI",
+      description: "",
+      env: {
+        OPENAI_API_KEY: "secret",
+        OPENAI_BASE_URL: "https://api.example.test/v1",
+      },
+      models: [
+        { id: "model-a", label: "model-a", isDefault: true },
+        { id: "model-b", label: "model-b" },
+      ],
+    });
+    expect(onClose).toHaveBeenCalledTimes(1);
+  });
+
+  it("keeps the provider ID and protocol immutable during edits", () => {
+    const initialDraft: CustomProviderDraft = {
+      ...EMPTY_DRAFT,
+      id: "existing-provider",
+      label: "Existing",
+      kind: "anthropic",
+      anthropicAuth: "authToken",
+      baseUrl: "https://api.example.test",
+      modelIds: "model-a",
+    };
+    render({
+      initialDraft,
+      originalId: "existing-provider",
+      existingConfig: { extends: "claude", enabled: false, label: "Existing" },
+    });
+
+    expect((query("custom-provider-id") as HTMLInputElement | null)?.disabled).toBe(true);
+    click("custom-provider-kind-acp");
+    expect(query("custom-provider-base-url")).not.toBeNull();
+    expect(query("custom-provider-command")).toBeNull();
+    click("custom-provider-anthropic-auth-api-key");
+    expect(query("custom-provider-anthropic-auth-field")?.getAttribute("data-value")).toBe(
+      "authToken",
+    );
+  });
+});
diff --git a/packages/app/src/screens/settings/custom-provider-edit-sheet.tsx b/packages/app/src/screens/settings/custom-provider-edit-sheet.tsx
