index 0000000000000000000000000000000000000000..d0ab076b1d4c841eb7877710f0ae89f6490265ad
--- /dev/null
+++ b/packages/app/src/screens/settings/custom-provider-edit-sheet.tsx
@@ -0,0 +1,515 @@
+import { useCallback, useEffect, useMemo, useState } from "react";
+import { Pressable, Text, View } from "react-native";
+import { useTranslation } from "react-i18next";
+import { StyleSheet, withUnistyles } from "react-native-unistyles";
+import type { MutableDaemonConfigPatch } from "@getpaseo/protocol/messages";
+import { Eye, EyeOff } from "lucide-react-native";
+import { AdaptiveModalSheet, type SheetHeader } from "@/components/adaptive-modal-sheet";
+import { Button } from "@/components/ui/button";
+import type { FieldControlSize } from "@/components/ui/control-geometry";
+import { Field, FormTextInput } from "@/components/ui/form-field";
+import { SelectField } from "@/components/ui/select-field";
+import { useIsCompactFormFactor } from "@/constants/layout";
+import {
+  buildCustomProviderConfig,
+  validateCustomProviderDraft,
+  type AnthropicAuthKind,
+  type CustomProviderDraft,
+  type CustomProviderField,
+  type CustomProviderKind,
+  type CustomProviderValidationCode,
+  type CustomProviderValidationErrors,
+} from "./custom-provider-form";
+
+type MutableProviderConfig = NonNullable<MutableDaemonConfigPatch["providers"]>[string];
+
+const ThemedEye = withUnistyles(Eye, (theme) => ({ color: theme.colors.foregroundMuted }));
+const ThemedEyeOff = withUnistyles(EyeOff, (theme) => ({ color: theme.colors.foregroundMuted }));
+
+export interface CustomProviderEditSheetProps {
+  visible: boolean;
+  initialDraft: CustomProviderDraft;
+  existingConfig?: MutableProviderConfig;
+  existingProviderIds: ReadonlySet<string>;
+  originalId?: string;
+  onClose: () => void;
+  onSave: (providerId: string, config: MutableProviderConfig) => Promise<void>;
+}
+
+function validationMessageKey(field: CustomProviderField, code: CustomProviderValidationCode) {
+  if (code === "invalidId") return "settings.providers.customForm.validation.invalidId";
+  if (code === "duplicateId") return "settings.providers.customForm.validation.duplicateId";
+  if (code === "invalidUrl") return "settings.providers.customForm.validation.invalidUrl";
+  if (field === "modelIds") return "settings.providers.customForm.validation.modelRequired";
+  return "settings.providers.customForm.validation.required";
+}
+
+export function CustomProviderEditSheet({
+  visible,
+  initialDraft,
+  existingConfig,
+  existingProviderIds,
+  originalId,
+  onClose,
+  onSave,
+}: CustomProviderEditSheetProps) {
+  const { t } = useTranslation();
+  const size: FieldControlSize = useIsCompactFormFactor() ? "md" : "sm";
+  const [draft, setDraft] = useState(initialDraft);
+  const [fieldErrors, setFieldErrors] = useState<CustomProviderValidationErrors>({});
+  const [submitError, setSubmitError] = useState<string | null>(null);
+  const [isPending, setIsPending] = useState(false);
+  const [isApiKeyVisible, setIsApiKeyVisible] = useState(false);
+  const isEditing = Boolean(originalId);
+
+  useEffect(() => {
+    if (!visible) {
+      setIsPending(false);
+      return;
+    }
+    setDraft(initialDraft);
+    setFieldErrors({});
+    setSubmitError(null);
+    setIsPending(false);
+    setIsApiKeyVisible(false);
+  }, [initialDraft, visible]);
+
+  const updateField = useCallback(
+    <K extends keyof CustomProviderDraft>(field: K, value: CustomProviderDraft[K]) => {
+      setDraft((current) => ({ ...current, [field]: value }));
+      setFieldErrors((current) => ({ ...current, [field]: undefined }));
+    },
+    [],
+  );
+
+  const kindOptions = useMemo(
+    () => [
+      {
+        id: "openai",
+        value: "openai" as const,
+        label: t("settings.providers.customForm.kinds.openai"),
+        testID: "custom-provider-kind-openai",
+      },
+      {
+        id: "anthropic",
+        value: "anthropic" as const,
+        label: t("settings.providers.customForm.kinds.anthropic"),
+        testID: "custom-provider-kind-anthropic",
+      },
+      {
+        id: "acp",
+        value: "acp" as const,
+        label: t("settings.providers.customForm.kinds.acp"),
+        testID: "custom-provider-kind-acp",
+      },
+    ],
+    [t],
+  );
+  const anthropicAuthOptions = useMemo(
+    () => [
+      {
+        id: "api-key",
+        value: "apiKey" as const,
+        label: t("settings.providers.customForm.anthropicAuthModes.apiKey"),
+        testID: "custom-provider-anthropic-auth-api-key",
+      },
+      {
+        id: "auth-token",
+        value: "authToken" as const,
+        label: t("settings.providers.customForm.anthropicAuthModes.authToken"),
+        testID: "custom-provider-anthropic-auth-token",
+      },
+    ],
+    [t],
+  );
+
+  const handleKindChange = useCallback(
+    (kind: CustomProviderKind) => {
+      if (!isEditing) updateField("kind", kind);
+    },
+    [isEditing, updateField],
+  );
+  const handleAnthropicAuthChange = useCallback(
+    (auth: AnthropicAuthKind) => {
+      if (!isEditing) updateField("anthropicAuth", auth);
+    },
+    [isEditing, updateField],
+  );
+  const handleIdChange = useCallback((value: string) => updateField("id", value), [updateField]);
+  const handleLabelChange = useCallback(
+    (value: string) => updateField("label", value),
+    [updateField],
+  );
+  const handleDescriptionChange = useCallback(
+    (value: string) => updateField("description", value),
+    [updateField],
+  );
+  const handleBaseUrlChange = useCallback(
+    (value: string) => updateField("baseUrl", value),
+    [updateField],
+  );
+  const handleApiKeyChange = useCallback(
+    (value: string) => updateField("apiKey", value),
+    [updateField],
+  );
+  const handleCommandChange = useCallback(
+    (value: string) => updateField("command", value),
+    [updateField],
+  );
+  const handleArgsChange = useCallback(
+    (value: string) => updateField("args", value),
+    [updateField],
+  );
+  const handleModelIdsChange = useCallback(
+    (value: string) => updateField("modelIds", value),
+    [updateField],
+  );
+  const handleToggleApiKeyVisibility = useCallback(
+    () => setIsApiKeyVisible((current) => !current),
+    [],
+  );
+
+  const errorFor = useCallback(
+    (field: CustomProviderField): string | null => {
+      const code = fieldErrors[field];
+      return code ? t(validationMessageKey(field, code)) : null;
+    },
+    [fieldErrors, t],
+  );
+
+  const handleSave = useCallback(async () => {
+    if (isPending) return;
+    const errors = validateCustomProviderDraft(draft, existingProviderIds, originalId);
+    setFieldErrors(errors);
+    setSubmitError(null);
+    if (Object.keys(errors).length > 0) return;
+
+    setIsPending(true);
+    try {
+      await onSave(draft.id.trim(), buildCustomProviderConfig(draft, existingConfig));
+      onClose();
+    } catch (error) {
+      setSubmitError(error instanceof Error ? error.message : t("common.errors.unableToSave"));
+    } finally {
+      setIsPending(false);
+    }
+  }, [draft, existingConfig, existingProviderIds, isPending, onClose, onSave, originalId, t]);
+
+  const handleCancel = useCallback(() => {
+    if (!isPending) onClose();
+  }, [isPending, onClose]);
+
+  const sheetHeader = useMemo<SheetHeader>(
+    () => ({
+      title: t(
+        isEditing
+          ? "settings.providers.customForm.editTitle"
+          : "settings.providers.customForm.addTitle",
+      ),
+    }),
+    [isEditing, t],
+  );
+  const selectedKindDisplay = useMemo(
+    () => ({
+      label: kindOptions.find((option) => option.value === draft.kind)?.label ?? draft.kind,
+    }),
+    [draft.kind, kindOptions],
+  );
+  const selectedAnthropicAuthDisplay = useMemo(
+    () => ({
+      label:
+        anthropicAuthOptions.find((option) => option.value === draft.anthropicAuth)?.label ??
+        draft.anthropicAuth,
+    }),
+    [anthropicAuthOptions, draft.anthropicAuth],
+  );
+  const footer = useMemo(
+    () => (
+      <View style={styles.actions}>
+        <Button
+          variant="secondary"
+          style={styles.actionButton}
+          onPress={handleCancel}
+          disabled={isPending}
+          testID="custom-provider-cancel"
+        >
+          {t("common.actions.cancel")}
+        </Button>
+        <Button
+          variant="default"
+          style={styles.actionButton}
+          onPress={handleSave}
+          disabled={isPending}
+          loading={isPending}
+          testID="custom-provider-save"
+        >
+          {t("settings.providers.customForm.save")}
+        </Button>
+      </View>
+    ),
+    [handleCancel, handleSave, isPending, t],
+  );
+
+  return (
+    <AdaptiveModalSheet
+      visible={visible}
+      header={sheetHeader}
+      onClose={handleCancel}
+      desktopMaxWidth={520}
+      footer={footer}
+      sizeContentToCurrentSnapPoint
+      testID="custom-provider-edit-sheet"
+    >
+      <View style={styles.body}>
+        <SelectField
+          label={t("settings.providers.customForm.type")}
+          value={draft.kind}
+          selectedDisplay={selectedKindDisplay}
+          options={kindOptions}
+          onChange={handleKindChange}
+          placeholder={t("settings.providers.customForm.type")}
+          emptyText={t("settings.providers.customForm.type")}
+          disabled={isPending || isEditing}
+          searchable={false}
+          size={size}
+          testID="custom-provider-kind-field"
+          triggerTestID="custom-provider-kind"
+        />
+
+        <Field
+          label={t("settings.providers.customForm.id")}
+          error={errorFor("id")}
+          testID="custom-provider-id-field"
+        >
+          <FormTextInput
+            size={size}
+            initialValue={initialDraft.id}
+            resetKey={`${visible}-${initialDraft.id}`}
+            onChangeText={handleIdChange}
+            placeholder={t("settings.providers.customForm.idPlaceholder")}
+            editable={!isPending && !isEditing}
+            autoCapitalize="none"
+            autoCorrect={false}
+            testID="custom-provider-id"
+            accessibilityLabel={t("settings.providers.customForm.id")}
+          />
+        </Field>
+
+        <Field
+          label={t("settings.providers.customForm.label")}
+          error={errorFor("label")}
+          testID="custom-provider-label-field"
+        >
+          <FormTextInput
+            size={size}
+            initialValue={initialDraft.label}
+            resetKey={`${visible}-${initialDraft.id}`}
+            onChangeText={handleLabelChange}
+            placeholder={t("settings.providers.customForm.labelPlaceholder")}
+            editable={!isPending}
+            autoCapitalize="words"
+            autoCorrect={false}
+            testID="custom-provider-label"
+            accessibilityLabel={t("settings.providers.customForm.label")}
+          />
+        </Field>
+
+        <Field label={t("settings.providers.customForm.description")}>
+          <FormTextInput
+            size={size}
+            initialValue={initialDraft.description}
+            resetKey={`${visible}-${initialDraft.id}`}
+            onChangeText={handleDescriptionChange}
+            placeholder={t("settings.providers.customForm.descriptionPlaceholder")}
+            editable={!isPending}
+            testID="custom-provider-description"
+            accessibilityLabel={t("settings.providers.customForm.description")}
+          />
+        </Field>
+
+        {draft.kind === "acp" ? (
+          <>
+            <Field
+              label={t("settings.providers.customForm.command")}
+              error={errorFor("command")}
+              testID="custom-provider-command-field"
+            >
+              <FormTextInput
+                size={size}
+                initialValue={draft.command}
+                resetKey={`${visible}-${initialDraft.id}-${draft.kind}`}
+                onChangeText={handleCommandChange}
+                placeholder={t("settings.providers.customForm.commandPlaceholder")}
+                editable={!isPending}
+                autoCapitalize="none"
+                autoCorrect={false}
+                testID="custom-provider-command"
+                accessibilityLabel={t("settings.providers.customForm.command")}
+              />
+            </Field>
+            <Field label={t("settings.providers.customForm.args")}>
+              <FormTextInput
+                size={size}
+                initialValue={draft.args}
+                resetKey={`${visible}-${initialDraft.id}-${draft.kind}`}
+                onChangeText={handleArgsChange}
+                placeholder={t("settings.providers.customForm.argsPlaceholder")}
+                editable={!isPending}
+                multiline
+                numberOfLines={3}
+                autoCapitalize="none"
+                autoCorrect={false}
+                testID="custom-provider-args"
+                accessibilityLabel={t("settings.providers.customForm.args")}
+              />
+            </Field>
+          </>
+        ) : (
+          <>
+            <Field
+              label={t("settings.providers.customForm.baseUrl")}
+              error={errorFor("baseUrl")}
+              testID="custom-provider-base-url-field"
+            >
+              <FormTextInput
+                size={size}
+                initialValue={draft.baseUrl}
+                resetKey={`${visible}-${initialDraft.id}-${draft.kind}`}
+                onChangeText={handleBaseUrlChange}
+                placeholder={t("settings.providers.customForm.baseUrlPlaceholder")}
+                editable={!isPending}
+                autoCapitalize="none"
+                autoCorrect={false}
+                keyboardType="url"
+                testID="custom-provider-base-url"
+                accessibilityLabel={t("settings.providers.customForm.baseUrl")}
+              />
+            </Field>
+            {draft.kind === "anthropic" ? (
+              <SelectField
+                label={t("settings.providers.customForm.anthropicAuth")}
+                value={draft.anthropicAuth}
+                selectedDisplay={selectedAnthropicAuthDisplay}
+                options={anthropicAuthOptions}
+                onChange={handleAnthropicAuthChange}
+                placeholder={t("settings.providers.customForm.anthropicAuth")}
+                emptyText={t("settings.providers.customForm.anthropicAuth")}
+                disabled={isPending || isEditing}
+                searchable={false}
+                size={size}
+                testID="custom-provider-anthropic-auth-field"
+                triggerTestID="custom-provider-anthropic-auth"
+              />
+            ) : null}
+            <Field label={t("settings.providers.customForm.apiKey")}>
+              <View style={styles.apiKeyRow}>
+                <FormTextInput
+                  size={size}
+                  style={styles.apiKeyInput}
+                  initialValue={draft.apiKey}
+                  resetKey={`${visible}-${initialDraft.id}-${draft.kind}`}
+                  onChangeText={handleApiKeyChange}
+                  placeholder={
+                    isEditing
+                      ? t("settings.providers.customForm.apiKeyUnchanged")
+                      : t("settings.providers.customForm.apiKeyPlaceholder")
+                  }
+                  editable={!isPending}
+                  autoCapitalize="none"
+                  autoCorrect={false}
+                  secureTextEntry={!isApiKeyVisible}
+                  testID="custom-provider-api-key"
+                  accessibilityLabel={t("settings.providers.customForm.apiKey")}
+                />
+                <Pressable
+                  style={styles.visibilityButton}
+                  onPress={handleToggleApiKeyVisibility}
+                  disabled={isPending}
+                  accessibilityRole="button"
+                  accessibilityLabel={t(
+                    isApiKeyVisible
+                      ? "settings.providers.customForm.hideApiKey"
+                      : "settings.providers.customForm.showApiKey",
+                  )}
+                  testID="custom-provider-api-key-visibility"
+                >
+                  {isApiKeyVisible ? <ThemedEyeOff size={18} /> : <ThemedEye size={18} />}
+                </Pressable>
+              </View>
+            </Field>
+          </>
+        )}
+
+        <Field
+          label={t("settings.providers.customForm.models")}
+          error={errorFor("modelIds")}
+          testID="custom-provider-models-field"
+        >
+          <FormTextInput
+            size={size}
+            initialValue={initialDraft.modelIds}
+            resetKey={`${visible}-${initialDraft.id}`}
+            onChangeText={handleModelIdsChange}
+            placeholder={t("settings.providers.customForm.modelsPlaceholder")}
+            editable={!isPending}
+            multiline
+            numberOfLines={3}
+            autoCapitalize="none"
+            autoCorrect={false}
+            testID="custom-provider-models"
+            accessibilityLabel={t("settings.providers.customForm.models")}
+          />
+        </Field>
+
+        {submitError ? (
+          <Text
+            style={styles.submitError}
+            accessibilityRole="alert"
+            accessibilityLiveRegion="polite"
+            testID="custom-provider-submit-error"
+          >
+            {submitError}
+          </Text>
+        ) : null}
+      </View>
+    </AdaptiveModalSheet>
+  );
+}
+
+const styles = StyleSheet.create((theme) => ({
+  body: {
+    gap: theme.spacing[4],
+    paddingBottom: theme.spacing[2],
+  },
+  apiKeyRow: {
+    flexDirection: "row",
+    alignItems: "center",
+    gap: theme.spacing[2],
+  },
+  apiKeyInput: {
+    flex: 1,
+    minWidth: 0,
+  },
+  visibilityButton: {
+    width: 40,
+    height: 40,
+    flexShrink: 0,
+    alignItems: "center",
+    justifyContent: "center",
+    borderRadius: theme.borderRadius.lg,
+    backgroundColor: theme.colors.surface2,
+  },
+  actions: {
+    flexDirection: "row",
+    alignItems: "center",
+    gap: theme.spacing[2],
+    marginTop: theme.spacing[2],
+  },
+  actionButton: {
+    flex: 1,
+  },
+  submitError: {
+    color: theme.colors.palette.red[300],
+    fontSize: theme.fontSize.base,
+  },
+}));
diff --git a/packages/app/src/screens/settings/custom-provider-form.test.ts b/packages/app/src/screens/settings/custom-provider-form.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..7e5e07729e2d873f228f0d1f393148e3971f08ea
--- /dev/null
+++ b/packages/app/src/screens/settings/custom-provider-form.test.ts
@@ -0,0 +1,203 @@
+import { describe, expect, it } from "vitest";
+import {
+  buildCustomProviderConfig,
+  draftFromCustomProviderConfig,
+  EMPTY_CUSTOM_PROVIDER_DRAFT,
+  parseModelIds,
+  validateCustomProviderDraft,
+  type CustomProviderDraft,
+} from "./custom-provider-form";
+
+function draft(overrides: Partial<CustomProviderDraft> = {}): CustomProviderDraft {
+  return {
+    ...EMPTY_CUSTOM_PROVIDER_DRAFT,
+    id: "my-provider",
+    label: "My provider",
+    baseUrl: "https://api.example.test/v1",
+    modelIds: "model-a",
+    ...overrides,
+  };
+}
+
+describe("custom provider form", () => {
+  it("normalizes unique model IDs from lines and commas", () => {
+    expect(parseModelIds(" model-a,model-b\nmodel-a\n model-c ")).toEqual([
+      "model-a",
+      "model-b",
+      "model-c",
+    ]);
+  });
+
+  it("validates IDs, duplicates, endpoint URLs, and required API models", () => {
+    expect(
+      validateCustomProviderDraft(
+        draft({
+          id: "Bad ID",
+          label: "",
+          baseUrl: "file:///tmp/api",
+          modelIds: "",
+        }),
+        new Set(),
+      ),
+    ).toEqual({
+      id: "invalidId",
+      label: "required",
+      baseUrl: "invalidUrl",
+      modelIds: "required",
+    });
+
+    expect(validateCustomProviderDraft(draft(), new Set(["my-provider"]))).toEqual({
+      id: "duplicateId",
+    });
+    expect(validateCustomProviderDraft(draft(), new Set(["my-provider"]), "my-provider")).toEqual(
+      {},
+    );
+  });
+
+  it("builds an explicitly enabled OpenAI-compatible config", () => {
+    expect(
+      buildCustomProviderConfig(
+        draft({
+          description: "Private endpoint",
+          apiKey: "secret-key",
+          modelIds: "model-a, model-b",
+        }),
+      ),
+    ).toEqual({
+      extends: "codex",
+      enabled: true,
+      label: "My provider",
+      description: "Private endpoint",
+      env: {
+        OPENAI_API_KEY: "secret-key",
+        OPENAI_BASE_URL: "https://api.example.test/v1",
+      },
+      models: [
+        { id: "model-a", label: "model-a", isDefault: true },
+        { id: "model-b", label: "model-b" },
+      ],
+    });
+  });
+
+  it("omits an unchanged API key so the server-side deep merge preserves it", () => {
+    const patch = buildCustomProviderConfig(draft({ kind: "anthropic", apiKey: "" }), {
+      extends: "claude",
+      enabled: false,
+      label: "Old label",
+      env: {
+        ANTHROPIC_AUTH_TOKEN: "stored-secret",
+        API_TIMEOUT_MS: "3000000",
+      },
+    });
+
+    expect(patch).toMatchObject({
+      extends: "claude",
+      enabled: false,
+      label: "My provider",
+      env: {
+        ANTHROPIC_BASE_URL: "https://api.example.test/v1",
+        API_TIMEOUT_MS: "3000000",
+      },
+    });
+    expect(patch.env).not.toHaveProperty("ANTHROPIC_AUTH_TOKEN");
+  });
+
+  it("supports standard Anthropic API-key and bearer-token authentication", () => {
+    const standard = buildCustomProviderConfig(
+      draft({ kind: "anthropic", anthropicAuth: "apiKey", apiKey: "standard-secret" }),
+    );
+    const bearer = buildCustomProviderConfig(
+      draft({ kind: "anthropic", anthropicAuth: "authToken", apiKey: "bearer-secret" }),
+    );
+
+    expect(standard.env).toMatchObject({ ANTHROPIC_API_KEY: "standard-secret" });
+    expect(standard.env).not.toHaveProperty("ANTHROPIC_AUTH_TOKEN");
+    expect(bearer.env).toMatchObject({ ANTHROPIC_AUTH_TOKEN: "bearer-secret" });
+    expect(bearer.env).not.toHaveProperty("ANTHROPIC_API_KEY");
+  });
+
+  it("builds ACP command argv and allows catalog discovery without configured models", () => {
+    const acpDraft = draft({
+      kind: "acp",
+      baseUrl: "",
+      command: "ollama-acp",
+      args: "--stdio\n--verbose",
+      modelIds: "",
+    });
+    expect(validateCustomProviderDraft(acpDraft, new Set())).toEqual({});
+    expect(buildCustomProviderConfig(acpDraft)).toMatchObject({
+      extends: "acp",
+      enabled: true,
+      command: ["ollama-acp", "--stdio", "--verbose"],
+      models: [],
+    });
+  });
+
+  it("round-trips ACP arguments without losing spaces inside an argument", () => {
+    const initialConfig = {
+      extends: "acp",
+      enabled: true,
+      label: "ACP wrapper",
+      command: ["wrapper-acp", "--profile", "Team Alpha", "--verbose"],
+    };
+    const hydrated = draftFromCustomProviderConfig("wrapper", initialConfig);
+
+    expect(hydrated?.args).toBe("--profile\nTeam Alpha\n--verbose");
