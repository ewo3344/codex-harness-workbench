@@ -0,0 +1,36 @@
+import type { MutableDaemonConfig } from "@getpaseo/protocol/messages";
+import { PROVIDER_CREDENTIAL_ENV_KEYS } from "./provider-config-credentials.js";
+
+const CLIENT_VISIBLE_PROVIDER_ENV_KEYS = new Set(["ANTHROPIC_BASE_URL", "OPENAI_BASE_URL"]);
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+/** Builds the daemon config view sent over client transports. */
+export function toClientDaemonConfig(config: MutableDaemonConfig): MutableDaemonConfig {
+  const providers = Object.fromEntries(
+    Object.entries(config.providers).map(([providerId, provider]) => {
+      const providerRecord = { ...(provider as Record<string, unknown>) };
+      const env = providerRecord.env;
+      delete providerRecord.env;
+
+      if (isRecord(env)) {
+        const visibleEnv = Object.fromEntries(
+          Object.entries(env).flatMap(([key, value]) => {
+            if (CLIENT_VISIBLE_PROVIDER_ENV_KEYS.has(key) && typeof value === "string") {
+              return [[key, value]];
+            }
+            if (PROVIDER_CREDENTIAL_ENV_KEYS.has(key)) return [[key, ""]];
+            return [];
+          }),
+        );
+        if (Object.keys(visibleEnv).length > 0) providerRecord.env = visibleEnv;
+      }
+
+      return [providerId, providerRecord];
+    }),
+  ) as MutableDaemonConfig["providers"];
+
+  return { ...config, providers };
+}
