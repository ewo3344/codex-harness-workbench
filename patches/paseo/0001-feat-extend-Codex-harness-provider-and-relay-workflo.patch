diff --git a/packages/desktop/e2e/relay-terminal-reconnect.e2e.mjs b/packages/desktop/e2e/relay-terminal-reconnect.e2e.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..06b9331d63e9180cf22b84228b16fb9dfeb46c82
--- /dev/null
+++ b/packages/desktop/e2e/relay-terminal-reconnect.e2e.mjs
@@ -0,0 +1,586 @@
+#!/usr/bin/env node
+
+import { execFile, execFileSync, spawn } from "node:child_process";
+import { createWriteStream, mkdirSync, mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import net from "node:net";
+import os from "node:os";
+import path from "node:path";
+import process from "node:process";
+import { promisify } from "node:util";
+import { setTimeout as delay } from "node:timers/promises";
+import { fileURLToPath } from "node:url";
+import { chromium } from "playwright";
+import { WebSocket } from "ws";
+import { parseConnectionOfferFromUrl } from "@getpaseo/protocol/connection-offer";
+import { buildRelayWebSocketUrl } from "@getpaseo/protocol/daemon-endpoints";
+
+const execFileAsync = promisify(execFile);
+const scriptDir = path.dirname(fileURLToPath(import.meta.url));
+const desktopDir = path.resolve(scriptDir, "..");
+const rootDir = path.resolve(desktopDir, "../..");
+const devRunner = path.join(desktopDir, "scripts", "dev-runner.mjs");
+const paseoCli = path.join(rootDir, "node_modules", ".bin", "paseo");
+const timeoutMs = 90_000;
+
+const TERMINAL_PROFILE = {
+  id: "relay-electron-terminal-probe",
+  name: "Relay Electron terminal probe",
+  command: "/bin/sh",
+  args: [
+    "-c",
+    [
+      "printf 'RELAY_ELECTRON_TERMINAL_READY\\n'",
+      "while IFS= read -r line; do",
+      "printf 'RELAY_ELECTRON_INPUT:%s\\n' \"$line\"",
+      "printf 'RELAY_ELECTRON_PTY_SIZE:'",
+      "stty size",
+      "done",
+    ].join("\n"),
+  ],
+};
+
+function assert(condition, message) {
+  if (!condition) throw new Error(message);
+}
+
+async function reservePort() {
+  return await new Promise((resolve, reject) => {
+    const server = net.createServer();
+    server.unref();
+    server.once("error", reject);
+    server.listen(0, "127.0.0.1", () => {
+      const address = server.address();
+      server.close((error) => {
+        if (error) return reject(error);
+        if (!address || typeof address === "string") return reject(new Error("No TCP port"));
+        resolve(address.port);
+      });
+    });
+  });
+}
+
+function spawnLogged(name, command, args, options, logDir) {
+  mkdirSync(logDir, { recursive: true });
+  const logPath = path.join(logDir, `${name}.log`);
+  const log = createWriteStream(logPath, { flags: "a" });
+  const child = spawn(command, args, {
+    ...options,
+    detached: process.platform !== "win32",
+    stdio: ["ignore", "pipe", "pipe"],
+  });
+  child.stdout.pipe(log, { end: false });
+  child.stderr.pipe(log, { end: false });
+  child.stdout.once("end", () => child.stderr.readableEnded && log.end());
+  child.stderr.once("end", () => child.stdout.readableEnded && log.end());
+  return { child, logPath };
+}
+
+function stopProcess(child) {
+  if (!child?.pid || child.exitCode !== null || child.signalCode !== null) return;
+  try {
+    process.kill(process.platform === "win32" ? child.pid : -child.pid, "SIGTERM");
+  } catch {
+    child.kill("SIGTERM");
+  }
+}
+
+async function waitForPort(port, label, processInfo) {
+  const deadline = Date.now() + timeoutMs;
+  while (Date.now() < deadline) {
+    if (processInfo?.child.exitCode !== null || processInfo?.child.signalCode !== null) {
+      throw new Error(`${label} exited before opening its port; see ${processInfo.logPath}`);
+    }
+    const connected = await new Promise((resolve) => {
+      const socket = net.createConnection({ host: "127.0.0.1", port });
+      socket.setTimeout(500);
+      socket.once("connect", () => {
+        socket.destroy();
+        resolve(true);
+      });
+      socket.once("timeout", () => {
+        socket.destroy();
+        resolve(false);
+      });
+      socket.once("error", () => resolve(false));
+    });
+    if (connected) return;
+    await delay(200);
+  }
+  throw new Error(`Timed out waiting for ${label} on ${port}`);
+}
+
+async function waitForHttp(url, label) {
+  const deadline = Date.now() + timeoutMs;
+  let lastError = "";
+  while (Date.now() < deadline) {
+    try {
+      const response = await fetch(url, { signal: AbortSignal.timeout(1_000) });
+      if (response.ok) return;
+      lastError = `HTTP ${response.status}`;
+    } catch (error) {
+      lastError = String(error);
+    }
+    await delay(200);
+  }
+  throw new Error(`${label} did not become ready: ${lastError}`);
+}
+
+async function waitForRelay(port, child) {
+  const deadline = Date.now() + timeoutMs;
+  while (Date.now() < deadline) {
+    if (child.exitCode !== null || child.signalCode !== null) {
+      throw new Error(`Relay exited before readiness (see relay process)`);
+    }
+    const url = buildRelayWebSocketUrl({
+      endpoint: `127.0.0.1:${port}`,
+      useTls: false,
+      serverId: `desktop-relay-readiness-${Date.now().toString(36)}`,
+      role: "server",
+    });
+    const opened = await new Promise((resolve) => {
+      const socket = new WebSocket(url);
+      let settled = false;
+      const settle = (value) => {
+        if (settled) return;
+        settled = true;
+        resolve(value);
+      };
+      const timer = setTimeout(() => {
+        socket.terminate();
+        settle(false);
+      }, 2_000);
+      socket.once("open", () => {
+        clearTimeout(timer);
+        socket.close();
+        settle(true);
+      });
+      socket.once("error", () => {
+        clearTimeout(timer);
+        settle(false);
+      });
+    });
+    if (opened) return;
+    await delay(250);
+  }
+  throw new Error(`Relay did not become ready on ${port}`);
+}
+
+async function startRelay(port, artifactDir) {
+  const wrangler = path.join(rootDir, "node_modules", "wrangler", "bin", "wrangler.js");
+  const relayRoot = path.join(rootDir, "packages", "relay");
+  const processInfo = spawnLogged(
+    "relay",
+    process.execPath,
+    [
+      wrangler,
+      "dev",
+      "--local",
+      "--ip",
+      "127.0.0.1",
+      "--port",
+      String(port),
+      "--live-reload=false",
+      "--show-interactive-dev-session=false",
+      "--var",
+      "PASEO_RELAY_UPSTREAM:",
+    ],
+    { cwd: relayRoot, env: { ...process.env } },
+    artifactDir,
+  );
+  await waitForPort(port, "Wrangler relay", processInfo);
+  await waitForRelay(port, processInfo.child);
+  return { ...processInfo, endpoint: `127.0.0.1:${port}` };
+}
+
+function createGitRepo(runtimeDir) {
+  const repo = mkdtempSync(path.join(runtimeDir, "repo-"));
+  execFileSync("git", ["init", "-q", repo]);
+  execFileSync("git", ["-C", repo, "config", "user.email", "e2e@example.invalid"]);
+  execFileSync("git", ["-C", repo, "config", "user.name", "Electron E2E"]);
+  writeFileSync(path.join(repo, "README.md"), "# Electron relay terminal\n");
+  execFileSync("git", ["-C", repo, "add", "README.md"]);
+  execFileSync("git", ["-C", repo, "commit", "-qm", "initial"]);
+  return repo;
+}
+
+async function startRemoteDaemon({ home, port, relayEndpoint, serverId, artifactDir }) {
+  mkdirSync(home, { recursive: true });
+  writeFileSync(
+    path.join(home, "config.json"),
+    `${JSON.stringify({ version: 1, daemon: { terminalProfiles: [TERMINAL_PROFILE] } })}\n`,
+  );
+  const env = {
+    ...process.env,
+    CI: "true",
+    NODE_ENV: "development",
+    PASEO_NODE_ENV: "development",
+    PASEO_HOME: home,
+    PASEO_SERVER_ID: serverId,
+    PASEO_RELAY_ENDPOINT: relayEndpoint,
+    PASEO_RELAY_PUBLIC_ENDPOINT: relayEndpoint,
+    PASEO_RELAY_USE_TLS: "false",
+    PASEO_RELAY_PUBLIC_USE_TLS: "false",
+    PASEO_LOCAL_SPEECH_AUTO_DOWNLOAD: "0",
+    PASEO_DICTATION_ENABLED: "0",
+    PASEO_VOICE_MODE_ENABLED: "0",
+  };
+  await execFileAsync(
+    paseoCli,
+    ["daemon", "start", "--home", home, "--port", String(port), "--relay", "--web-ui"],
+    { env },
+  );
+  await waitForHttp(`http://127.0.0.1:${port}/api/health`, "Remote daemon");
+  return {
+    home,
+    port,
+    serverId,
+    endpoint: `127.0.0.1:${port}`,
+    env,
+    async pairingOfferUrl() {
+      const { stdout } = await execFileAsync(
+        paseoCli,
+        ["daemon", "pair", "--home", home, "--relay", "--json"],
+        { env },
+      );
+      const result = JSON.parse(stdout);
+      assert(typeof result.url === "string", `Pairing command returned no URL: ${stdout}`);
+      return result.url;
+    },
+    async close() {
+      await execFileAsync(paseoCli, ["daemon", "stop", "--home", home], { env }).catch(
+        () => undefined,
+      );
+      rmSync(home, { recursive: true, force: true });
+    },
+    artifactDir,
+  };
+}
+
+async function createProject(daemon, repo) {
+  const { stdout } = await execFileAsync(
+    paseoCli,
+    ["project", "create", repo, "--host", daemon.endpoint, "--json"],
+    { env: daemon.env },
+  );
+  const project = JSON.parse(stdout);
+  assert(typeof project.projectId === "string", `Project create returned no id: ${stdout}`);
+  return project;
+}
+
+async function waitForAppPage(browser, expoPort) {
+  const deadline = Date.now() + timeoutMs;
+  while (Date.now() < deadline) {
+    for (const context of browser.contexts()) {
+      for (const page of context.pages()) {
+        if (page.url().includes(`localhost:${expoPort}`)) return page;
+      }
+    }
+    await delay(250);
+  }
+  throw new Error("Timed out waiting for the Electron renderer");
+}
+
+async function reloadRendererAfterInitScript(browser, initialPage, expoPort) {
+  const targetUrl = `http://localhost:${expoPort}/`;
+  try {
+    await initialPage.goto(targetUrl, { waitUntil: "commit", timeout: 15_000 });
+  } catch (error) {
+    const message = error instanceof Error ? error.message : String(error);
+    if (!message.includes("ERR_ABORTED") && !message.includes("frame was detached")) {
+      throw error;
+    }
+  }
+  await delay(500);
+  return await waitForAppPage(browser, expoPort);
+}
+
+async function terminalBufferText(page) {
+  return await page.evaluate(() => {
+    const terminal = globalThis.__paseoTerminal;
+    if (!terminal?.buffer?.active) return "";
+    const lines = [];
+    for (let index = 0; index < terminal.buffer.active.length; index += 1) {
+      const line = terminal.buffer.active.getLine(index);
+      if (line) lines.push(line.translateToString(true));
+    }
+    return lines.join("\n");
+  });
+}
+
+async function waitForTerminalText(page, expected, timeout = 30_000) {
+  const deadline = Date.now() + timeout;
+  while (Date.now() < deadline) {
+    if ((await terminalBufferText(page)).includes(expected)) return;
+    await page.waitForTimeout(100);
+  }
+  throw new Error(`Terminal output did not contain ${expected}`);
+}
+
+async function readTerminalSize(page) {
+  return await page.evaluate(() => {
+    const terminal = globalThis.__paseoTerminal;
+    return typeof terminal?.rows === "number" && typeof terminal?.cols === "number"
+      ? { rows: terminal.rows, cols: terminal.cols }
+      : null;
+  });
+}
+
+function routeForNewWorkspace(serverId, repo, projectId) {
+  const params = new URLSearchParams({
+    serverId,
+    dir: repo,
+    name: "Electron relay terminal",
+    projectId,
+  });
+  return `/new?${params.toString()}`;
+}
+
+async function runElectronTerminalFlow({ page, appOrigin, daemon, repo, projectId, relay }) {
+  const directSocketUrls = [];
+  const relaySocketUrls = [];
+  const relayWirePayloads = [];
+  const onWebSocket = (socket) => {
+    const url = socket.url();
+    if (url.includes(`:${daemon.port}/ws`)) directSocketUrls.push(url);
+    if (url.includes(relay.endpoint)) {
+      relaySocketUrls.push(url);
+      socket.on("framesent", ({ payload }) => {
+        relayWirePayloads.push(Buffer.isBuffer(payload) ? payload : Buffer.from(payload));
+      });
+      socket.on("framereceived", ({ payload }) => {
+        relayWirePayloads.push(Buffer.isBuffer(payload) ? payload : Buffer.from(payload));
+      });
+    }
+  };
+  page.on("websocket", onWebSocket);
+  try {
+    await page.goto(new URL(routeForNewWorkspace(daemon.serverId, repo, projectId), appOrigin));
+    const launchTrigger = page.getByTestId("new-workspace-launch-trigger");
+    await launchTrigger.waitFor({ state: "visible", timeout: timeoutMs });
+    await launchTrigger.click();
+    await page
+      .getByTestId(`new-workspace-launch-option-${TERMINAL_PROFILE.id}`)
+      .waitFor({ state: "visible", timeout: timeoutMs });
+    await page.getByTestId(`new-workspace-launch-option-${TERMINAL_PROFILE.id}`).click();
+    const submit = page.getByTestId("new-workspace-launch-submit");
+    await submit.waitFor({ state: "visible", timeout: timeoutMs });
+    await submit.click();
+
+    const terminalSurface = page.locator('[data-testid="terminal-surface"]:visible').first();
+    await terminalSurface.waitFor({ state: "visible", timeout: timeoutMs });
+    await page.waitForFunction(() => Boolean(globalThis.__paseoTerminal), null, {
+      timeout: timeoutMs,
+    });
+    await waitForTerminalText(page, "RELAY_ELECTRON_TERMINAL_READY");
+
+    await terminalSurface.click();
+    await terminalSurface.pressSequentially("relay-electron-input\n", { delay: 0 });
+    await waitForTerminalText(page, "RELAY_ELECTRON_INPUT:relay-electron-input");
+
+    const initialSize = await readTerminalSize(page);
+    assert(initialSize, "Electron terminal did not report an xterm size");
+    await page.setViewportSize({ width: 1100, height: 620 });
+    const resizedSize = await page
+      .waitForFunction(
+        (previous) => {
+          const terminal = globalThis.__paseoTerminal;
+          return terminal && (terminal.rows !== previous.rows || terminal.cols !== previous.cols)
+            ? { rows: terminal.rows, cols: terminal.cols }
+            : null;
+        },
+        initialSize,
+        { timeout: 15_000 },
+      )
+      .then((handle) => handle.jsonValue());
+    assert(resizedSize, "Electron terminal did not resize after viewport change");
+    await terminalSurface.pressSequentially("resize-electron\n", { delay: 0 });
+    await waitForTerminalText(
+      page,
+      `RELAY_ELECTRON_PTY_SIZE:${resizedSize.rows} ${resizedSize.cols}`,
+    );
+
+    const beforeDisconnect = await terminalBufferText(page);
+    stopProcess(relay.child);
+    await page.getByText("Host is not connected", { exact: true }).waitFor({
+      state: "visible",
+      timeout: 30_000,
+    });
+    await page.waitForTimeout(750);
+    const disconnectedBuffer = await terminalBufferText(page);
+    assert(
+      disconnectedBuffer === beforeDisconnect,
+      "Terminal buffer changed while the relay was disconnected",
+    );
+
+    const restartedRelay = await startRelay(relay.port, daemon.artifactDir);
+    relay.child = restartedRelay.child;
+    await terminalSurface.waitFor({ state: "visible", timeout: 60_000 });
+    await waitForTerminalText(page, "RELAY_ELECTRON_INPUT:relay-electron-input", 60_000);
+    await terminalSurface.click();
+    await terminalSurface.pressSequentially("relay-electron-after-reconnect\n", { delay: 0 });
+    await waitForTerminalText(page, "RELAY_ELECTRON_INPUT:relay-electron-after-reconnect", 60_000);
+
+    assert(directSocketUrls.length === 0, `Electron opened direct daemon sockets: ${directSocketUrls}`);
+    assert(relaySocketUrls.length > 0, "Electron did not open a relay WebSocket");
+    const wireBytes = Buffer.concat(relayWirePayloads);
+    for (const plaintext of [
+      "RELAY_ELECTRON_TERMINAL_READY",
+      "relay-electron-input",
+      "RELAY_ELECTRON_INPUT:relay-electron-after-reconnect",
+    ]) {
+      assert(wireBytes.indexOf(Buffer.from(plaintext)) === -1, `Relay wire exposed plaintext ${plaintext}`);
+    }
+
+    return {
+      relaySocketCount: relaySocketUrls.length,
+      directSocketCount: directSocketUrls.length,
+      initialSize,
+      resizedSize,
+      streamPausedWhileDisconnected: disconnectedBuffer === beforeDisconnect,
+      terminalRestoredWithoutUserAction: true,
+      postReconnectInput: "passed",
+      relayWirePlaintextProbes: 0,
+    };
+  } finally {
+    page.off("websocket", onWebSocket);
+  }
+}
+
+async function main() {
+  const artifactDir =
+    process.env.PASEO_DESKTOP_RELAY_TERMINAL_ARTIFACT_DIR ??
+    mkdtempSync(path.join(os.tmpdir(), "paseo-desktop-relay-terminal-"));
+  const runtimeDir = mkdtempSync(path.join(os.tmpdir(), "paseo-desktop-relay-terminal-runtime-"));
+  mkdirSync(artifactDir, { recursive: true });
+  const desktopHome = path.join(runtimeDir, "desktop-home");
+  const remoteHome = path.join(runtimeDir, "remote-home");
+  const userData = path.join(runtimeDir, "electron-user-data");
+  const repo = createGitRepo(runtimeDir);
+  const [daemonPort, relayPort, expoPort, cdpPort] = await Promise.all([
+    reservePort(),
+    reservePort(),
+    reservePort(),
+    reservePort(),
+  ]);
+  const serverId = `desktop-relay-terminal-${Date.now().toString(36)}`;
+  let relay = null;
+  let daemon = null;
+  let desktop = null;
+  let browser = null;
+  let page = null;
+  try {
+    relay = await startRelay(relayPort, artifactDir);
+    daemon = await startRemoteDaemon({
+      home: remoteHome,
+      port: daemonPort,
+      relayEndpoint: relay.endpoint,
+      serverId,
+      artifactDir,
+    });
+    const project = await createProject(daemon, repo);
+    const offer = parseConnectionOfferFromUrl(await daemon.pairingOfferUrl());
+    assert(offer, "Remote daemon returned no relay pairing offer");
+    const relayConnection = {
+      id: `relay:${offer.relay.endpoint}`,
+      type: "relay",
+      relayEndpoint: offer.relay.endpoint,
+      useTls: offer.relay.useTls ?? false,
+      daemonPublicKeyB64: offer.daemonPublicKeyB64,
+    };
+    const host = {
+      serverId: offer.serverId,
+      label: "Electron relay terminal host",
+      connections: [relayConnection],
+      preferredConnectionId: relayConnection.id,
+      createdAt: new Date().toISOString(),
+      updatedAt: new Date().toISOString(),
+    };
+
+    const commonEnv = {
+      ...process.env,
+      PASEO_HOME: desktopHome,
+      PASEO_LISTEN: `127.0.0.1:${await reservePort()}`,
+      PASEO_DAEMON_ENDPOINT: `127.0.0.1:${daemonPort}`,
+      EXPO_PUBLIC_LOCAL_DAEMON: "127.0.0.1:9",
+      PASEO_CORS_ORIGINS: "*",
+      PASEO_LOCAL_SPEECH_AUTO_DOWNLOAD: "0",
+      PASEO_DICTATION_ENABLED: "0",
+      PASEO_VOICE_MODE_ENABLED: "0",
+      PASEO_DISABLE_REACT_DEVTOOLS: "1",
+      FORCE_COLOR: "0",
+      NO_COLOR: "1",
+      PASEO_DEBUG: "1",
+    };
+    mkdirSync(desktopHome, { recursive: true });
+    const desktopArgs = [
+      process.execPath,
+      devRunner,
+      ...(process.platform === "linux" ? ["--no-sandbox"] : []),
+    ];
+    const useXvfb = process.platform === "linux" && !process.env.DISPLAY;
+    const desktopCommand = useXvfb ? "xvfb-run" : desktopArgs.shift();
+    const desktopCommandArgs = useXvfb
+      ? ["-a", "--server-args=-screen 0 1280x800x24", ...desktopArgs]
+      : desktopArgs;
+    desktop = spawnLogged(
+      "desktop",
+      desktopCommand,
+      desktopCommandArgs,
+      {
+        cwd: rootDir,
+        env: {
+          ...commonEnv,
+          EXPO_PORT: String(expoPort),
+          EXPO_DEV_URL: `http://localhost:${expoPort}`,
+          PASEO_ELECTRON_REMOTE_DEBUGGING_PORT: String(cdpPort),
+          PASEO_ELECTRON_USER_DATA_DIR: userData,
+          PASEO_ELECTRON_FLAGS: `--remote-debugging-address=127.0.0.1 --remote-debugging-port=${cdpPort}`,
+        },
+      },
+      artifactDir,
+    );
+    await waitForPort(cdpPort, "Electron CDP", desktop);
+    browser = await chromium.connectOverCDP(`http://127.0.0.1:${cdpPort}`);
+    page = await waitForAppPage(browser, expoPort);
+    await page.routeWebSocket(new RegExp(`:${daemon.port}/ws`), async (socket) => {
+      await socket.close({ code: 1008, reason: "Direct daemon disabled for relay E2E" });
+    });
+    await page.route(new RegExp(`:${daemon.port}/`), (route) => route.abort());
+    await page.addInitScript((storedHost) => {
+      localStorage.setItem("@paseo:e2e", "1");
+      localStorage.setItem("@paseo:daemon-registry", JSON.stringify([storedHost]));
+    }, host);
+    page = await reloadRendererAfterInitScript(browser, page, expoPort);
+    await page.getByTestId(`sidebar-host-row-${daemon.serverId}`).waitFor({
+      state: "visible",
+      timeout: timeoutMs,
+    });
+    const report = await runElectronTerminalFlow({
+      page,
+      appOrigin: `http://localhost:${expoPort}`,
+      daemon,
+      repo,
+      projectId: project.projectId,
+      relay,
+    });
+    writeFileSync(path.join(artifactDir, "result.json"), `${JSON.stringify(report, null, 2)}\n`);
+    console.log(
+      `Electron relay terminal E2E passed: input, PTY output, resize, relay pause/reconnect, and encrypted wire checks passed (${JSON.stringify(report)}).`,
+    );
+  } catch (error) {
+    writeFileSync(path.join(artifactDir, "failure.txt"), `${String(error)}\n`);
+    console.error(`Electron relay terminal E2E failed. Artifacts: ${artifactDir}`);
+    console.error(error);
+    throw error;
+  } finally {
+    await browser?.close().catch(() => undefined);
+    stopProcess(desktop?.child);
+    stopProcess(relay?.child);
+    await daemon?.close();
+    rmSync(repo, { recursive: true, force: true });
+    rmSync(runtimeDir, { recursive: true, force: true });
+    await delay(1_000);
+  }
+}
+
+await main();
