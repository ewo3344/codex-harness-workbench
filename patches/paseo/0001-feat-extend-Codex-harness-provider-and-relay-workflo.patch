diff --git a/packages/app/e2e/browser/custom-provider-lifecycle.spec.ts b/packages/app/e2e/browser/custom-provider-lifecycle.spec.ts
new file mode 100644
index 0000000000000000000000000000000000000000..8a8b61f0e6d691502dc154c12c4c3961cadf39ec
--- /dev/null
+++ b/packages/app/e2e/browser/custom-provider-lifecycle.spec.ts
@@ -0,0 +1,132 @@
+import { readFile } from "node:fs/promises";
+import path from "node:path";
+import { expect, test } from "../support/fixtures";
+import { gotoAppShell, openSettings } from "../support/helpers/app";
+import { getServerId } from "../support/helpers/server-id";
+import {
+  expectHostProvidersCard,
+  expectSettingsHeader,
+  openSettingsHost,
+  openHostSection,
+} from "../support/helpers/settings";
+
+const PROVIDER_ID = "e2e-openai";
+const PROVIDER_LABEL = "E2E OpenAI";
+const PROVIDER_URL = "https://api.example.test/v1";
+
+async function readPersistedProviders(): Promise<Record<string, unknown>> {
+  const paseoHome = process.env.E2E_PASEO_HOME;
+  if (!paseoHome) throw new Error("E2E_PASEO_HOME is not set by the E2E worker");
+  const raw = await readFile(path.join(paseoHome, "config.json"), "utf8");
+  const parsed = JSON.parse(raw) as { agents?: { providers?: unknown } };
+  return (parsed.agents?.providers ?? {}) as Record<string, unknown>;
+}
+
+async function openProviders(page: Parameters<typeof expectHostProvidersCard>[0]) {
+  const serverId = getServerId();
+  await gotoAppShell(page);
+  await openSettings(page);
+  await openSettingsHost(page, serverId);
+  await openHostSection(page, serverId, "providers");
+  await expectHostProvidersCard(page, serverId);
+  await expectSettingsHeader(page, "Providers");
+}
+
+async function fillOpenAiProviderForm(page: Parameters<typeof expectHostProvidersCard>[0]) {
+  await page.getByTestId("custom-provider-id").fill(PROVIDER_ID);
+  await page.getByTestId("custom-provider-label").fill(PROVIDER_LABEL);
+  await page.getByTestId("custom-provider-base-url").fill(PROVIDER_URL);
+  await page.getByTestId("custom-provider-api-key").fill("e2e-secret");
+  await page.getByTestId("custom-provider-models").fill("e2e-model\ne2e-model-mini");
+}
+
+test.describe("custom provider lifecycle", () => {
+  test("creates, edits, disables, re-enables, and removes a provider", async ({ page }) => {
+    await openProviders(page);
+
+    await page.setViewportSize({ width: 390, height: 844 });
+    await page.getByTestId("custom-provider-add").click();
+    const cancelButton = page.getByRole("button", { name: "Cancel", exact: true });
+    await expect(cancelButton).toBeVisible();
+    await cancelButton.click();
+    await expect(cancelButton).toHaveCount(0);
+    await page.setViewportSize({ width: 1280, height: 720 });
+
+    await page.getByTestId("custom-provider-add").click();
+    const editor = page.getByTestId("custom-provider-edit-sheet");
+    await expect(editor).toBeVisible();
+    await fillOpenAiProviderForm(page);
+    await editor.getByTestId("custom-provider-save").click();
+
+    await expect(editor).toHaveCount(0, { timeout: 15_000 });
+    const row = page.getByRole("button", {
+      name: `${PROVIDER_LABEL} provider details`,
+      exact: true,
+    });
+    await expect(row).toBeVisible({ timeout: 15_000 });
+    await expect(row.getByRole("switch")).toHaveAttribute("aria-checked", "true");
+
+    await expect
+      .poll(async () => {
+        const providers = await readPersistedProviders();
+        return PROVIDER_ID in providers;
+      })
+      .toBe(true);
+    const persistedAfterCreate = await readPersistedProviders();
+    expect(persistedAfterCreate[PROVIDER_ID]).toMatchObject({
+      extends: "codex",
+      enabled: true,
+      label: PROVIDER_LABEL,
+    });
+
+    await row.getByTestId(`provider-actions-${PROVIDER_ID}`).click();
+    await page.getByTestId(`provider-edit-${PROVIDER_ID}`).click();
+    await expect(editor).toBeVisible();
+    await expect(page.getByTestId("custom-provider-id")).toHaveValue(PROVIDER_ID);
+    await page.getByTestId("custom-provider-label").fill("E2E OpenAI Edited");
+    await editor.getByTestId("custom-provider-save").click();
+    await expect(editor).toHaveCount(0, { timeout: 15_000 });
+
+    const editedRow = page.getByRole("button", {
+      name: "E2E OpenAI Edited provider details",
+      exact: true,
+    });
+    await expect(editedRow).toBeVisible({ timeout: 15_000 });
+    await expect
+      .poll(async () => {
+        const providers = await readPersistedProviders();
+        return (providers[PROVIDER_ID] as { label?: string } | undefined)?.label;
+      })
+      .toBe("E2E OpenAI Edited");
+
+    const toggle = editedRow.getByRole("switch");
+    await toggle.click();
+    await expect(toggle).toHaveAttribute("aria-checked", "false");
+    await expect
+      .poll(async () => {
+        const providers = await readPersistedProviders();
+        return (providers[PROVIDER_ID] as { enabled?: boolean } | undefined)?.enabled;
+      })
+      .toBe(false);
+
+    await toggle.click();
+    await expect(toggle).toHaveAttribute("aria-checked", "true");
+    await expect
+      .poll(async () => {
+        const providers = await readPersistedProviders();
+        return (providers[PROVIDER_ID] as { enabled?: boolean } | undefined)?.enabled;
+      })
+      .toBe(true);
+
+    await editedRow.getByTestId(`provider-actions-${PROVIDER_ID}`).click();
+    page.once("dialog", (dialog) => void dialog.accept());
+    await page.getByTestId(`provider-remove-${PROVIDER_ID}`).click();
+    await expect(editedRow).toHaveCount(0, { timeout: 15_000 });
+    await expect
+      .poll(async () => {
+        const providers = await readPersistedProviders();
+        return PROVIDER_ID in providers;
+      })
+      .toBe(false);
+  });
+});
diff --git a/packages/app/e2e/browser/new-workspace-default-terminal.spec.ts b/packages/app/e2e/browser/new-workspace-default-terminal.spec.ts
