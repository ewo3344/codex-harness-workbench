+async function waitForCondition(
+  predicate: () => boolean,
+  timeout = 20_000,
+  interval = 10,
+): Promise<void> {
+  const start = Date.now();
+  while (Date.now() - start < timeout) {
+    if (predicate()) {
+      return;
+    }
+    await new Promise((resolve) => setTimeout(resolve, interval));
+  }
+  throw new Error(`Timed out waiting for condition after ${timeout}ms`);
+}
