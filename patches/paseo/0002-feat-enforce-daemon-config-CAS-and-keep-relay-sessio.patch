+function parseLatestPtySize(text) {
+  const matches = [...text.matchAll(/RELAY_ELECTRON_PTY_SIZE:(\d+) (\d+)/g)];
+  const latest = matches.at(-1);
+  return latest?.[1] && latest[2]
+    ? { rows: Number(latest[1]), cols: Number(latest[2]) }
+    : null;
+}
+
+async function waitForPtySize(page, terminalSurface, expected, timeout) {
+  const deadline = Date.now() + timeout;
+  let probe = 1;
+  while (Date.now() < deadline) {
+    await terminalSurface.pressSequentially(`resize-electron-${probe++}\n`, { delay: 0 });
+    const actual = parseLatestPtySize(await terminalBufferText(page));
+    if (actual?.rows === expected.rows && actual.cols === expected.cols) return actual;
+    await delay(150);
+  }
+  throw new Error(
+    `PTY resize output did not match ${expected.rows} ${expected.cols}; latest output: ${
+      parseLatestPtySize(await terminalBufferText(page)) ?? "none"
+    }`,
+  );
+}
+
+async function waitForTerminalQuiescence(page, settleMs = 300, timeout = 5_000) {
+  const deadline = Date.now() + timeout;
+  let previous = await terminalBufferText(page);
+  while (Date.now() < deadline) {
+    await delay(settleMs);
+    const current = await terminalBufferText(page);
+    if (current === previous) return current;
+    previous = current;
+  }
+  return previous;
+}
