+async function waitForHostRuntime(browser, expoPort, initialPage) {
+  const deadline = Date.now() + timeoutMs;
+  let page = initialPage;
+  let reloads = 0;
+  while (Date.now() < deadline) {
+    const candidates = expoPages(browser, expoPort);
+    if (page && !page.isClosed() && !candidates.includes(page)) {
+      candidates.unshift(page);
     }
+    for (const candidate of candidates) {
+      try {
+        await candidate.waitForFunction(() => Boolean(globalThis.__paseoHostRuntimeStore), null, {
+          timeout: 500,
+        });
+        return candidate;
+      } catch {
+        // The document can expose its URL before the Expo bundle executes.
+      }
+    }
+
+    // CDP may attach after the first navigation started. Reloading the target
+    // once makes the context init script effective and recovers from a stale
+    // Chromium error document without masking later startup failures.
+    if (reloads < 1 && candidates[0]) {
+      reloads += 1;
+      try {
+        await candidates[0].reload({ waitUntil: "commit", timeout: 15_000 });
+      } catch {
+        // Navigation errors are followed by another target/runtime probe.
+      }
+    }
+    await delay(250);
