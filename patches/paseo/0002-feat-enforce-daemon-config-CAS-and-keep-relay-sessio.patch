@@ -22,3 +22,56 @@ export function registerDevRunnerShutdownSignals({ signalSource, stop }) {
     signalSource.on(signal, () => stop("SIGTERM"));
   }
 }
+
+export async function waitForHttpReady(
+  url,
+  {
+    fetchImpl = globalThis.fetch,
+    timeoutMs = 60_000,
+    attemptTimeoutMs = 1_000,
+    retryDelayMs = 250,
+    sleep = (delayMs) => new Promise((resolve) => setTimeout(resolve, delayMs)),
+    readBody = false,
+  } = {},
+) {
+  const deadline = Date.now() + timeoutMs;
+  let lastError = null;
+
+  while (Date.now() < deadline) {
+    try {
+      const response = await fetchImpl(url, {
+        signal: AbortSignal.timeout(attemptTimeoutMs),
+      });
+      if (response.ok) {
+        if (readBody && typeof response.text === "function") {
+          return await response.text();
+        }
+        await response.body?.cancel?.();
+        return;
+      }
+      lastError = `HTTP ${response.status}`;
+      await response.body?.cancel?.();
+    } catch (error) {
+      lastError = String(error);
+    }
+    await sleep(retryDelayMs);
+  }
+
+  throw new Error(
+    `Timed out waiting for ${url}${lastError ? `: ${lastError}` : ""}`,
+  );
+}
+
+export async function waitForExpoBundleReady(url, options = {}) {
+  const html = await waitForHttpReady(url, { ...options, readBody: true });
+  if (typeof html !== "string") return;
+
+  const bundleSource = html.match(/<script[^>]+src=["']([^"']*\.bundle[^"']*)["']/i)?.[1];
+  if (!bundleSource) return;
+
+  await waitForHttpReady(new URL(bundleSource, url).toString(), {
+    ...options,
+    readBody: true,
+    attemptTimeoutMs: Math.max(options.attemptTimeoutMs ?? 1_000, 30_000),
+  });
+}
