+
+async function loadDevelopmentUrlWithRetry(
+  window: BrowserWindow,
+  url: string,
+  maxAttempts = 3,
+): Promise<void> {
+  for (let attempt = 1; attempt <= maxAttempts; attempt += 1) {
+    try {
+      await window.loadURL(url);
+      return;
+    } catch (error) {
+      if (attempt >= maxAttempts || !isTransientDevelopmentLoadError(error)) {
+        throw error;
+      }
+      log.warn("[window] development server load failed; retrying", {
+        attempt,
+        maxAttempts,
+        url,
+        error,
+      });
+      await new Promise((resolve) => setTimeout(resolve, 500 * attempt));
+    }
+  }
+}
