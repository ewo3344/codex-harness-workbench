{
  "version": 1,
  "daemon": {
    "listen": "127.0.0.1:6877",
    "cors": {
      "allowedOrigins": ["https://app.paseo.sh"]
    },
    "relay": {
      "enabled": false
    },
    "mcp": {
      "enabled": false,
      "injectIntoAgents": false
    }
  },
  "app": {
    "baseUrl": "https://app.paseo.sh"
  },
  "pluginsEnabled": false,
  "agents": {
    "providers": {
      "claude": { "enabled": false },
      "copilot": { "enabled": false },
      "opencode": { "enabled": false },
      "pi": { "enabled": false },
      "omp": { "enabled": false },
      "codex": { "enabled": true }
    },
    "metadataGeneration": {
      "providers": [{ "provider": "codex", "model": "gpt-5.6-luna", "thinkingOptionId": "low" }]
    }
  },
  "features": {
    "dictation": { "enabled": false },
    "voiceMode": { "enabled": false },
    "webUi": { "enabled": true }
  }
}
